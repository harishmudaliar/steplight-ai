
# ==========================================================
# STEPLIGHT AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Team: OLYMPUS | Tagline: "One Tiny Step. Zero Shame."
# ==========================================================

# APPLICATION
APP_NAME="Steplight AI"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# ==========================================================
# GOOGLE GEMINI API (Backend only - never exposed to browser)
# ==========================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=1
# Optional USD per million tokens; leave unset to disable cost estimates.
GEMINI_INPUT_COST_PER_MILLION=
GEMINI_OUTPUT_COST_PER_MILLION=
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1024

# ==========================================================
# FASTAPI BACKEND
# ==========================================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=18765
API_PREFIX=/api
BACKEND_URL=http://127.0.0.1:18765
API_BASE_URL=http://127.0.0.1:18765/api

# ==========================================================
# REACT WEBSITE (Vite whitelists only VITE_* prefix)
# ==========================================================
FRONTEND_HOST=localhost
FRONTEND_PORT=5173
VITE_APP_NAME="Steplight AI"
VITE_APP_VERSION=1.0.0
# Local development only; production must set this safe public URL to the deployed HTTPS API.
VITE_API_BASE_URL=http://127.0.0.1:18765/api
VITE_DEFAULT_THEME=light

# ==========================================================
# ELECTRON DESKTOP APPLICATION
# ==========================================================
DESKTOP_APP_NAME="Steplight AI"
# Electron dev mode uses Vite; built desktop uses the stable app://steplight origin.
DESKTOP_DEV_SERVER_URL=http://localhost:5173
WINDOW_WIDTH=1366
WINDOW_HEIGHT=768
WINDOW_MIN_WIDTH=900
WINDOW_MIN_HEIGHT=600

# ==========================================================
# DATABASE (Backend only; SQLite for local development, hosted PostgreSQL for production)
# ==========================================================
DATABASE_URL=sqlite:///./steplight.db

# ==========================================================
# LOCAL STRATEGY RETRIEVAL (backend only)
# ==========================================================
STRATEGY_KB_PATH=backend\knowledge_base\strategies.v1.json
STRATEGY_INDEX_DIR=backend\data\strategy-index-v1
STRATEGY_RETRIEVAL_TOP_K=3
STRATEGY_MIN_RELEVANCE_SCORE=0.28

# ==========================================================
# AUTHENTICATION AND SECURITY (Backend only)
# ==========================================================
JWT_SECRET_KEY=CHANGE_TO_A_SECURE_RANDOM_SECRET_FOR_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_HASH_ALGORITHM=argon2

# ==========================================================
# CORS
# ==========================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,app://steplight

# ==========================================================
# TASK MANAGEMENT
# ==========================================================
DEFAULT_CAPACITY=medium
MAX_TASK_LENGTH=2000
MAX_STEP_LENGTH=300
ENABLE_PERSONALIZATION=true

# ==========================================================
# AI TASK SEQUENCER
# ==========================================================
ENABLE_ADAPTIVE_STEPS=true
ENABLE_STEP_QUALITY_GUARD=true
MAX_STEP_RETRIES=3

# ==========================================================
# LOGGING
# ==========================================================
LOG_LEVEL=INFO
